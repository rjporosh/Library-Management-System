{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "InMemory",
    "Orm": "EfCore",
    "ConnectionString": "",
    "MigrateOnStartup": false,
    "SeedOnStartup": true
  },
  "Jwt": {
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryManagementSystem.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 120
  },
  "Borrowing": {
    "MaxActiveBorrowsPerMember": 2
  },
  "Chat": {
    "Enabled": true,
    "Provider": "RuleBased",
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-3-5-haiku-20241022"
    },
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4o-mini"
    }
  },
  "Speech": {
    "Enabled": true,
    "Provider": "WebSpeech",
    "HuggingFace": {
      "ApiKey": "",
      "Model": "openai/whisper-large-v3"
    }
  },
  "BulkImport": {
    "MaxFileSizeBytes": 5242880,
    "MaxRows": 5000,
    "MaxErrors": 500
  },
  "FeatureFlags": {
    "LogsRootPath": "logs",
    "EnableRuntimeErrorLogging": true,
    "EnableBuildErrorLogging": true,
    "EnableQueryLogging": true,
    "EnableExceptionLogging": true,
    "EnableMemberSuspensionCronJob": true,
    "EnableHealthCheckEndpoint": true,
    "EnableLogDownloadEndpoint": true
  }
}
